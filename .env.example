# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# LLM_PROVIDER selects the adapter behind the LlmClient interface.
#   mock              deterministic local model, no network, no key (default)
#   openai-compatible any /v1/chat/completions endpoint (Groq, OpenRouter, ...)
LLM_PROVIDER=mock

# Base URL of an OpenAI-compatible chat completions API.
# Groq free tier: https://api.groq.com/openai/v1
LLM_BASE_URL=https://api.groq.com/openai/v1

# API key for the provider above. Never commit a real key.
LLM_API_KEY=

# Model id, e.g. llama-3.1-8b-instant (Groq free tier).
LLM_MODEL=llama-3.1-8b-instant

# Client-side throttling so a free tier is not tripped.
# Requests per minute and *tokens* per minute are both limited by free tiers.
LLM_MAX_CONCURRENCY=2
LLM_REQUESTS_PER_MINUTE=25
LLM_TOKENS_PER_MINUTE=12000
LLM_MAX_ATTEMPTS=4
LLM_TIMEOUT_MS=45000

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
# Per-request timeout and byte ceiling for any page fetched from the open web.
FETCH_TIMEOUT_MS=10000
FETCH_MAX_BYTES=2000000
# Politeness delay applied per host between requests (ms).
CRAWL_DELAY_MS=400
# Upper bound on pages fetched per company.
CRAWL_MAX_PAGES=14
# Upper bound on link-graph depth from the company homepage.
CRAWL_MAX_DEPTH=3

# ALLOW_PRIVATE_NETWORK=true permits loopback/private addresses.
# Required by the batch entry point, which is run against locally served
# company sites. Leave false in production: it is the SSRF guard.
ALLOW_PRIVATE_NETWORK=false

# ---------------------------------------------------------------------------
# Public interview discussion search (optional)
# ---------------------------------------------------------------------------
# SEARCH_PROVIDER: duckduckgo (no key, HTML endpoint) | brave | none
SEARCH_PROVIDER=duckduckgo
# Only needed when SEARCH_PROVIDER=brave
BRAVE_API_KEY=

# ---------------------------------------------------------------------------
# Persistence
# ---------------------------------------------------------------------------
# MONGODB_URI is optional. When it is absent the app persists kits to
# ./.data as JSON documents, which keeps a clean clone runnable with no
# database installed.
MONGODB_URI=
KIT_STORE_DIR=.data

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
PORT=4000
# HMAC secret for session tokens. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-in-production
SESSION_TTL_HOURS=12

# ---------------------------------------------------------------------------
# Pipeline
# ---------------------------------------------------------------------------
# Maximum coverage passes (first draft + gap-filling rounds).
MAX_COVERAGE_PASSES=3
# Log level: silent | error | info | debug
LOG_LEVEL=info
